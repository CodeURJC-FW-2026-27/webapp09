<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{#isEdit}}Edit Computer{{/isEdit}}{{^isEdit}}Build your PC{{/isEdit}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
    <link rel="icon" type="image/png" href="/images/ChatGPT Image 6 oct 2026, 15_42_56.png">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="/computers">PC Parts Catalog</a>
            <a class="nav-link" href="/computers">Home</a>
        </div>
    </nav>
    <header class="bg-dark py-4"><div class="container px-4 px-lg-5"><h1 class="display-6 fw-bolder text-white">{{#isEdit}}Edit Computer{{/isEdit}}{{^isEdit}}Build your PC{{/isEdit}}</h1></div></header>

    <main class="container my-5 flex-grow-1">
        <div class="row justify-content-center"><div class="col-12 col-lg-8">
            <div class="card shadow-sm"><div class="card-body p-4">
                <h2 class="mb-4">{{#isEdit}}Edit Computer{{/isEdit}}{{^isEdit}}Create New Computer{{/isEdit}}</h2>
                {{#errorMessage}}<div class="alert alert-danger" role="alert">{{errorMessage}}</div>{{/errorMessage}}
                <form method="post" action="{{action}}">
                    <h4 class="mb-3">Basic Information</h4>
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" name="name" value="{{computer.name}}" maxlength="100" required>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="brand" class="form-label">Brand</label>
                            <input type="text" class="form-control" id="brand" name="brand" value="{{computer.brand}}" maxlength="100" {{^isEdit}}required{{/isEdit}}>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="type" class="form-label">Type</label>
                            <select class="form-select" id="type" name="type" {{^isEdit}}required{{/isEdit}}>
                                <option value="">Unspecified</option>
                                {{#typeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/typeOptions}}
                            </select>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="price" class="form-label">Price (€)</label>
                            <input type="number" class="form-control" id="price" name="price" value="{{computer.price}}" min="0" step="0.01" {{^isEdit}}required{{/isEdit}}>
                        </div>
                    </div>

                    <h4 class="mt-4 mb-3">Description</h4>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="5" maxlength="2000" {{^isEdit}}required{{/isEdit}}>{{computer.description}}</textarea>
                    </div>

                    <h4 class="mt-4 mb-3">Additional Information</h4>
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label for="releaseDate" class="form-label">Release Date</label>
                            <input type="date" class="form-control" id="releaseDate" name="releaseDate" value="{{computer.releaseDate}}" {{^isEdit}}required{{/isEdit}}>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label for="image" class="form-label">Image path or URL</label>
                            <input type="text" class="form-control" id="image" name="image" value="{{computer.image}}" maxlength="2048" placeholder="images/pcgaming.png" {{^isEdit}}required{{/isEdit}}>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="used" class="form-label">Condition</label>
                        <select class="form-select" id="used" name="used">
                            <option value="" {{#computer.usedUnspecifiedSelected}}selected{{/computer.usedUnspecifiedSelected}}>Unspecified</option>
                            <option value="false" {{#computer.usedNewSelected}}selected{{/computer.usedNewSelected}}>New</option>
                            <option value="true" {{#computer.usedUsedSelected}}selected{{/computer.usedUsedSelected}}>Used</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{cancelUrl}}" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">{{#isEdit}}Save Changes{{/isEdit}}{{^isEdit}}Save Computer{{/isEdit}}</button>
                    </div>
                </form>
            </div></div>
        </div></div>
    </main>
    <footer class="py-5 bg-dark"><div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
