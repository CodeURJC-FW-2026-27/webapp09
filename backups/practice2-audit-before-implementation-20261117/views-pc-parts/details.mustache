<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{computer.name}} - PC Parts Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
    <link rel="icon" type="image/png" href="/images/ChatGPT Image 6 oct 2026, 15_42_56.png">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="/computers">PC Parts Catalog</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link" href="/computers">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/computers/new">Build your PC</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <header class="bg-dark py-4">
        <div class="container px-4 px-lg-5"><h1 class="display-6 fw-bolder text-white mb-0">Computer details</h1></div>
    </header>

    <main class="container px-4 px-lg-5 my-5 flex-grow-1">
        <div class="row">
            {{#computer.imageUrl}}<div class="col-md-6"><img src="{{computer.imageUrl}}" class="img-fluid rounded" alt="{{computer.name}}"></div>{{/computer.imageUrl}}
            <div class="col-md-6">
                <h2>{{computer.name}}</h2>
                {{#computer.brand}}<p><strong>Brand:</strong> {{computer.brand}}</p>{{/computer.brand}}
                {{#computer.type}}<p><strong>Type:</strong> {{computer.type}}</p>{{/computer.type}}
                {{#computer.priceDisplay}}<p><strong>Price:</strong> €{{computer.priceDisplay}}</p>{{/computer.priceDisplay}}
                {{#computer.releaseDate}}<p><strong>Release Date:</strong> {{computer.releaseDate}}</p>{{/computer.releaseDate}}
                {{#computer.usedLabel}}<p><strong>Used:</strong> {{computer.usedLabel}}</p>{{/computer.usedLabel}}
                {{#computer.description}}<p><strong>Description:</strong> {{computer.description}}</p>{{/computer.description}}
                <div class="mt-4 d-flex flex-wrap gap-2">
                    <a href="/computers/{{computer._id}}/edit" class="btn btn-warning">Edit</a>
                    <form action="/computers/{{computer._id}}/delete" method="post" onsubmit="return confirm('Delete this computer?')"><button type="submit" class="btn btn-danger">Delete</button></form>
                    <a href="/computers" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>

        {{#computer.detailPage}}
        <section class="mt-4 border rounded p-3">
            <h2 class="h5">Additional details from the original details page</h2>
            {{#description}}<p>{{description}}</p>{{/description}}
            {{#price}}<p><strong>Details page price:</strong> €{{price}}</p>{{/price}}
            {{#imageUrl}}<p><strong>Details page image:</strong> <a href="{{imageUrl}}">View image</a></p>{{/imageUrl}}
        </section>
        {{/computer.detailPage}}

        <section class="mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h2>Components</h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark">{{componentCount}} components</span>
                    <a class="btn btn-dark btn-sm" href="/computers/{{computer._id}}/components/new">Add Component</a>
                </div>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {{#components}}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        {{#imageUrl}}<a href="/computers/{{computerId}}/components/{{id}}"><img src="{{imageUrl}}" class="card-img-top" alt="{{name}}"></a>{{/imageUrl}}
                        <div class="card-body">
                            <h3 class="h5"><a class="text-dark text-decoration-none" href="/computers/{{computerId}}/components/{{id}}">{{name}}</a></h3>
                            {{#type}}<p><strong>Type:</strong> {{type}}</p>{{/type}}
                            {{#brand}}<p><strong>Brand:</strong> {{brand}}</p>{{/brand}}
                            {{#priceDisplay}}<p><strong>Price:</strong> €{{priceDisplay}}</p>{{/priceDisplay}}
                            <div class="d-flex gap-2">
                                <a href="/computers/{{computerId}}/components/{{id}}/edit" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/computers/{{computerId}}/components/{{id}}/delete" method="post" onsubmit="return confirm('Delete this component?')"><button type="submit" class="btn btn-danger btn-sm">Delete</button></form>
                            </div>
                        </div>
                    </div>
                </div>
                {{/components}}
                {{^components}}<p class="text-muted">No components have been added to this computer yet.</p>{{/components}}
            </div>
        </section>
    </main>

    <footer class="py-5 bg-dark"><div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
