<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{#isEdit}}Edit Component{{/isEdit}}{{^isEdit}}Add Component{{/isEdit}} - {{computer.name}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
    <link rel="icon" type="image/png" href="/images/ChatGPT Image 6 oct 2026, 15_42_56.png">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light"><div class="container px-4 px-lg-5"><a class="navbar-brand" href="/computers">PC Parts Catalog</a><a class="nav-link" href="/computers/{{computer._id}}">{{computer.name}}</a></div></nav>
    <header class="bg-dark py-4"><div class="container px-4 px-lg-5"><h1 class="display-6 fw-bolder text-white">{{#isEdit}}Edit Component{{/isEdit}}{{^isEdit}}Add Component{{/isEdit}}</h1></div></header>
    <main class="container my-5 flex-grow-1">
        <div class="row justify-content-center"><div class="col-12 col-lg-8"><div class="card shadow-sm"><div class="card-body p-4">
            <h2 class="mb-4">{{computer.name}}</h2>
            {{#errorMessage}}<div class="alert alert-danger" role="alert">{{errorMessage}}</div>{{/errorMessage}}
            <form method="post" action="{{action}}">
                <div class="mb-3"><label for="name" class="form-label">Component name</label><input type="text" class="form-control" id="name" name="name" value="{{component.name}}" maxlength="100" required></div>
                <div class="mb-3"><label for="brand" class="form-label">Brand</label><input type="text" class="form-control" id="brand" name="brand" value="{{component.brand}}" maxlength="100" {{^isEdit}}required{{/isEdit}}></div>
                <div class="mb-3"><label for="type" class="form-label">Component type</label>
                    <select class="form-select" id="type" name="type" {{^isEdit}}required{{/isEdit}}>
                        <option value="">Unspecified</option>
                        {{#typeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/typeOptions}}
                    </select>
                </div>
                <div class="mb-3"><label for="description" class="form-label">Description</label><textarea class="form-control" id="description" name="description" rows="4" maxlength="2000" {{^isEdit}}required{{/isEdit}}>{{component.description}}</textarea></div>
                <div class="mb-3"><label for="price" class="form-label">Price (€)</label><input type="number" class="form-control" id="price" name="price" value="{{component.price}}" min="0" step="0.01" {{^isEdit}}required{{/isEdit}}></div>
                <div class="mb-4"><label for="image" class="form-label">Image path or URL</label><input type="text" class="form-control" id="image" name="image" value="{{component.image}}" maxlength="2048" {{^isEdit}}required{{/isEdit}}></div>
                <div class="d-flex justify-content-end gap-2"><a href="{{cancelUrl}}" class="btn btn-secondary">Cancel</a><button type="submit" class="btn btn-primary">{{#isEdit}}Save Changes{{/isEdit}}{{^isEdit}}Create Component{{/isEdit}}</button></div>
            </form>
        </div></div></div></div>
    </main>
    <footer class="py-5 bg-dark"><div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
