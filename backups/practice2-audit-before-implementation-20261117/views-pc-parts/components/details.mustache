<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{component.name}} - PC Parts Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
    <link rel="icon" type="image/png" href="/images/ChatGPT Image 6 oct 2026, 15_42_56.png">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light"><div class="container px-4 px-lg-5"><a class="navbar-brand" href="/computers">PC Parts Catalog</a><a class="nav-link" href="/computers/{{computer._id}}">{{computer.name}}</a></div></nav>
    <header class="bg-dark py-4"><div class="container px-4 px-lg-5"><h1 class="display-6 fw-bolder text-white mb-0">Component details</h1></div></header>
    <main class="container px-4 px-lg-5 my-5 flex-grow-1">
        <div class="row align-items-center g-4">
            {{#component.imageUrl}}<div class="col-md-6"><img src="{{component.imageUrl}}" class="img-fluid rounded" alt="{{component.name}}"></div>{{/component.imageUrl}}
            <div class="col-md-6">
                <h2>{{component.name}}</h2>
                {{#component.brand}}<p><strong>Brand:</strong> {{component.brand}}</p>{{/component.brand}}
                {{#component.type}}<p><strong>Type:</strong> {{component.type}}</p>{{/component.type}}
                {{#component.priceDisplay}}<p><strong>Price:</strong> €{{component.priceDisplay}}</p>{{/component.priceDisplay}}
                {{#component.description}}<p><strong>Description:</strong> {{component.description}}</p>{{/component.description}}
                <p><strong>Computer:</strong> <a href="/computers/{{computer._id}}">{{computer.name}}</a></p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a href="/computers/{{computer._id}}/components/{{component.id}}/edit" class="btn btn-warning">Edit</a>
                    <form action="/computers/{{computer._id}}/components/{{component.id}}/delete" method="post" onsubmit="return confirm('Delete this component?')"><button class="btn btn-danger" type="submit">Delete</button></form>
                    <a href="/computers/{{computer._id}}" class="btn btn-secondary">Back to computer</a>
                </div>
            </div>
        </div>
    </main>
    <footer class="py-5 bg-dark"><div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
