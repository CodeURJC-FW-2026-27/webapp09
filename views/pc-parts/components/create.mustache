{{> header}}
    <div class="row justify-content-center"><div class="col-lg-9 col-xl-8">
        <p class="text-muted">Computer: <a href="/computers/{{computer._id}}">{{computer.name}}</a></p>
        {{#errorMessage}}<div class="alert alert-danger" role="alert">{{errorMessage}}</div>{{/errorMessage}}
        <form method="post" action="{{action}}" enctype="multipart/form-data" class="card p-4 p-md-5">
            <div class="mb-3"><label for="name" class="form-label">Component name</label><input class="form-control" id="name" name="name" type="text" value="{{component.name}}" maxlength="100" pattern="[A-ZÀ-ÖØ-Þ].*" title="Start with an uppercase letter." required></div>
            <div class="mb-3"><label for="brand" class="form-label">Brand</label><input class="form-control" id="brand" name="brand" type="text" value="{{component.brand}}" maxlength="100" required></div>
            <div class="mb-3"><label for="type" class="form-label">Component type</label><select class="form-select" id="type" name="type" required>{{^component.hasTypeSelection}}<option value="" disabled selected hidden>Choose a type</option>{{/component.hasTypeSelection}}{{#component.typeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/component.typeOptions}}</select></div>
            <div class="mb-3"><label for="description" class="form-label">Description</label><textarea class="form-control" id="description" name="description" rows="4" minlength="10" maxlength="2000" required>{{component.description}}</textarea></div>
            <div class="mb-3"><label for="price" class="form-label">Price (€)</label><input class="form-control" id="price" name="price" type="number" value="{{component.price}}" min="0" step="0.01" required></div>
            <div class="mb-4"><label for="image" class="form-label">Component image (PNG, JPEG, or WebP; max 5 MB)</label>{{#component.imageSource}}<div class="mb-2"><img class="img-thumbnail" style="max-height: 180px" src="{{component.imageSource}}" alt="Current component image" onerror="this.onerror=null;this.src='/images/image-unavailable.svg'"></div>{{/component.imageSource}}<input class="form-control" id="image" name="image" type="file" accept="image/png,image/jpeg,image/webp" {{^isEdit}}required{{/isEdit}}>{{#isEdit}}<div class="form-text">Leave empty to keep the current image.</div>{{/isEdit}}</div>
            <div class="d-flex justify-content-end gap-2"><a class="btn btn-secondary" href="{{cancelUrl}}">Cancel</a><button class="btn btn-primary" type="submit">{{#isEdit}}Save changes{{/isEdit}}{{^isEdit}}Create component{{/isEdit}}</button></div>
        </form>
    </div></div>
{{> footer}}
