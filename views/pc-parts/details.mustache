{{> header}}
    <div class="row align-items-start g-4 mb-5">
        {{#computer.imageUrl}}<div class="col-md-6"><img src="{{computer.imageUrl}}" class="img-fluid rounded" alt="{{computer.name}}" onerror="this.onerror=null;this.src='/images/image-unavailable.svg'"></div>{{/computer.imageUrl}}
        <div class="col-md-6">
            {{#computer.brand}}<p><strong>Brand:</strong> {{computer.brand}}</p>{{/computer.brand}}
            {{#computer.type}}<p><strong>Type:</strong> {{computer.type}}</p>{{/computer.type}}
            {{#computer.priceDisplay}}<p><strong>Price:</strong> €{{computer.priceDisplay}}</p>{{/computer.priceDisplay}}
            {{#computer.releaseDate}}<p><strong>Release date:</strong> {{computer.releaseDate}}</p>{{/computer.releaseDate}}
            <p><strong>Used:</strong> {{computer.usedLabel}}</p>
            {{#computer.description}}<p>{{computer.description}}</p>{{/computer.description}}
            <div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-warning" href="/computers/{{computer.id}}/edit">Edit</a><form action="/computers/{{computer.id}}/delete" method="post"><button class="btn btn-danger" type="submit">Delete</button></form><a class="btn btn-secondary" href="/computers">Back to catalog</a></div>
        </div>
    </div>
    <section><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h3 mb-0">Components ({{componentCount}})</h2><a class="btn btn-primary" href="/computers/{{computer.id}}/components/new">Add component</a></div>
        {{#componentCount}}
        <div class="row gx-4 gx-lg-5 row-cols-1 row-cols-md-2 row-cols-xl-3">
            {{#components}}<div class="col mb-4"><article class="card h-100">{{#imageUrl}}<a href="/computers/{{computerId}}/components/{{id}}"><img class="card-img-top pc-img" src="{{imageUrl}}" alt="{{name}}" onerror="this.onerror=null;this.src='/images/image-unavailable.svg'"></a>{{/imageUrl}}<div class="card-body text-center"><h3 class="h5"><a class="text-dark text-decoration-none" href="/computers/{{computerId}}/components/{{id}}">{{name}}</a></h3>{{#type}}<p>{{type}}</p>{{/type}}{{#priceDisplay}}<p>€{{priceDisplay}}</p>{{/priceDisplay}}<a class="btn btn-outline-dark" href="/computers/{{computerId}}/components/{{id}}">View component</a> <a class="btn btn-warning" href="/computers/{{computerId}}/components/{{id}}/edit">Edit</a><form class="d-inline" action="/computers/{{computerId}}/components/{{id}}/delete" method="post"><button class="btn btn-danger" type="submit">Delete</button></form></div></article></div>{{/components}}
        </div>
        {{/componentCount}}
        {{^componentCount}}<p class="alert alert-info">No components are associated with this computer yet.</p>{{/componentCount}}
    </section>
{{> footer}}
