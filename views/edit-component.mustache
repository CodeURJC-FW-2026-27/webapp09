<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit component - PC Parts Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body>
    <header class="bg-dark py-4">
        <div class="container px-4 px-lg-5">
            <h1 class="display-6 fw-bolder text-white">Edit component</h1>
        </div>
    </header>
    <main class="container my-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                {{#error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/error}}
                <form action="{{formAction}}" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input id="name" name="name" class="form-control" value="{{component.name}}" required>
                    </div>
                    <div class="mb-3">
                        <label for="brand" class="form-label">Brand</label>
                        <input id="brand" name="brand" class="form-control" value="{{component.brand}}" required>
                    </div>
                    <div class="mb-3">
                        <label for="type" class="form-label">Type</label>
                        <select id="type" name="type" class="form-select" required>
                            {{#componentTypes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/componentTypes}}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" name="description" class="form-control" maxlength="1000" required>{{component.description}}</textarea>
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price (€)</label>
                        <input id="price" name="price" type="number" min="0" step="0.01" class="form-control" value="{{component.price}}" required>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Image URL</label>
                        <input id="image" name="image" class="form-control" value="{{component.image}}">
                        <input name="imageFile" type="file" accept="image/*" class="form-control mt-2">
                    </div>
                    <button class="btn btn-primary" type="submit">Save component</button>
                    <a class="btn btn-secondary" href="/computers/{{computer.id}}">Cancel</a>
                </form>
            </div>
        </div>
    </main>
</body>
</html>