<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{computer.name}} - PC Parts Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="CSS/Style.css">
    <link rel="icon" type="image/png" href="images\ChatGPT Image 6 oct 2026, 15_42_56.png"> <!-- Icon for the browser tab  -->
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="Index.html">PC Parts Catalog</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link" href="Index.html">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="create.html">Build your PC</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <header class="bg-dark py-4">
        <div class="container px-4 px-lg-5">
            <h1 class="display-6 fw-bolder text-white mb-0">Computer details</h1>
        </div>
    </header>

    <main class="container px-4 px-lg-5 my-5 flex-grow-1">
        <div class="row">
            <div class="col-md-6">
                <img src="{{computer.image}}" class="img-fluid rounded" alt="{{computer.name}}">
            </div>
            <div class="col-md-6">
                <h2>{{computer.name}}</h2>
                <p><strong>Brand:</strong> {{computer.brand}}</p>
                <p><strong>Type:</strong> {{computer.type}}</p>
                <p><strong>Price:</strong> {{computer.price}}</p>
                <p><strong>Release Date:</strong> {{computer.releaseDate}}</p>
                <p><strong>Used:</strong> {{#computer.used}}Yes{{/computer.used}}{{^computer.used}}No{{/computer.used}}</p>
                <p><strong>Description:</strong> {{computer.description}}</p>
                <div class="mt-4">
                    <a href="#" class="btn btn-danger">Delete</a>
                    <a href="#" class="btn btn-warning">Edit</a>
                    <a href="Index.html" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>

        <section class="mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Components</h2>
                <span class="badge bg-dark">{{components.length}} components</span>
            </div>

            <div class="row row-cols-1 row-cols-md-2 g-4">
                {{#components}}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="{{image}}" class="card-img-top" alt="{{name}}">
                        <div class="card-body">
                            <h3 class="h5">{{name}}</h3>
                            <p><strong>Type:</strong> {{type}}</p>
                            <button type="button" class="btn btn-danger btn-sm">Delete</button>
                            <button type="button" class="btn btn-warning btn-sm">Edit</button>
                        </div>
                    </div>
                </div>
                {{/components}}
            </div>
        </section>

        <hr class="my-5">

        <h2>Add Component</h2>

        <form class="mt-3">
            <div class="mb-3">
                <label for="componentName" class="form-label">Component name</label>
                <input type="text" class="form-control" id="componentName" required>
            </div>

            <div class="mb-3">
                <label for="componentType" class="form-label">Component type</label>
                <select class="form-select" id="componentType">
                    <option>CPU</option>
                    <option>GPU</option>
                    <option>Motherboard</option>
                    <option>RAM</option>
                    <option>Storage</option>
                    <option>PSU</option>
                    <option>Case</option>
                    <option>Cooling System</option>
                </select>
            </div>

            <button type="submit" class="btn btn-dark">Create</button>
        </form>
    </main>

    <footer class="py-5 bg-dark">
        <div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/scripts.js"></script>
</body>
</html>

