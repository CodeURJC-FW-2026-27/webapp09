<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{computer.name}} - PC Parts Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Style.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="/">PC Parts Catalog</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/computers/new">Create a computer</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <header class="bg-dark py-4">
        <div class="container px-4 px-lg-5">
            <h1 class="display-6 fw-bolder text-white mb-0">Computer details</h1>
        </div>
    </header>

    <main class="container px-4 px-lg-5 my-5 flex-grow-1">
        <div class="row">
            <div class="col-md-6">
                <img src="{{computer.image}}" class="img-fluid rounded" alt="{{computer.name}}">
            </div>
            <div class="col-md-6">
                <h2>{{computer.name}}</h2>
                <p><strong>Brand:</strong> {{computer.brand}}</p>
                <p><strong>Type:</strong> {{computer.type}}</p>
                <p><strong>Price:</strong> {{computer.price}}</p>
                <p><strong>Release Date:</strong> {{computer.releaseDate}}</p>
                <p><strong>Used:</strong> {{#computer.used}}Yes{{/computer.used}}{{^computer.used}}No{{/computer.used}}</p>
                <p><strong>Description:</strong> {{computer.description}}</p>
                <div class="mt-4">
                    <form action="/computers/{{computer.id}}/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this computer and all its components?')">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <a href="/computers/{{computer.id}}/edit" class="btn btn-warning">Edit</a>
                    <a href="/" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>

        <section class="mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2>Components</h2>
                <span class="badge bg-dark">{{componentCount}} components</span>
            </div>

            {{#hasComponents}}
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {{#components}}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        {{#image}}<img src="{{image}}" class="card-img-top" alt="{{name}}">{{/image}}
                        <div class="card-body">
                            <h3 class="h5">{{name}}</h3>
                            <p><strong>Brand:</strong> {{brand}}</p>
                            <p><strong>Type:</strong> {{type}}</p>
                            <p><strong>Description:</strong> {{description}}</p>
                            <p><strong>Price:</strong> {{price}} €</p>
                            <a href="/computers/{{computer.id}}/components/{{id}}/edit" class="btn btn-warning btn-sm">Edit</a>
                            <form action="/computers/{{computer.id}}/components/{{id}}/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this component?')">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                {{/components}}
            </div>
            {{/hasComponents}}
            {{^hasComponents}}<p>No components have been added to this computer yet.</p>{{/hasComponents}}
        </section>

        <hr class="my-5">

        <h2>Add Component</h2>

        {{#error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/error}}
        <form class="mt-3" action="/computers/{{computer.id}}/components" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-12 col-md-6 mb-3">
                    <label for="componentName" class="form-label">Component name</label>
                    <input type="text" class="form-control" id="componentName" name="name" value="{{component.name}}" required>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <label for="componentBrand" class="form-label">Brand</label>
                    <input type="text" class="form-control" id="componentBrand" name="brand" value="{{component.brand}}" required>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <label for="componentType" class="form-label">Component type</label>
                    <select class="form-select" id="componentType" name="type" required>
                        <option value="" disabled {{^component.type}}selected{{/component.type}}>Select component type</option>
                        {{#componentTypes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/componentTypes}}
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <label for="componentPrice" class="form-label">Price (€)</label>
                    <input type="number" class="form-control" id="componentPrice" name="price" value="{{component.price}}" min="0" step="0.01" required>
                </div>
                <div class="col-12 mb-3">
                    <label for="componentDescription" class="form-label">Description</label>
                    <textarea class="form-control" id="componentDescription" name="description" rows="3" maxlength="1000" required>{{component.description}}</textarea>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <label for="componentImageFile" class="form-label">Upload image</label>
                    <input type="file" class="form-control" id="componentImageFile" name="imageFile" accept="image/*" {{^component.id}}required{{/component.id}}>
                    <img class="image-preview mt-2" src="{{component.image}}" alt="Selected component image" {{^component.image}}hidden{{/component.image}}>
                </div>
            </div>
            <button type="submit" class="btn btn-dark">Create component</button>
        </form>
    </main>

    <footer class="py-5 bg-dark">
        <div class="container"><p class="m-0 text-center text-white">&copy; 2026 PC Parts Catalog. All rights reserved.</p></div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
